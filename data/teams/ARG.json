  "news": [
    {
      "title": "Fußball-WM: Argentinien dreht das Rüpel-Halbfinale gegen England",
      "source": "Fußball-WM 2026: News, Videos und Spielplan zur WM 2026",
      "url": "https://www.sportschau.de/fussball/fifa-wm-2026/argentinien-dreht-ruepel-halbfinale-gegen-england,wm-spielbericht-england-argentinien-100.html",
      "publishedAt": "2026-07-15T21:12:43.000Z",
      "snippet": "Argentinien hat ein knallhartes und fast schon verlorenes Halbfinale gegen England im Schlussspurt gedreht und den Three Lions das erste WM-Endspiel seit 1966 verwehrt.",
      "impactTag": "none"
    },
    {
      "title": "Messi mit zwei Vorlagen: Argentinien dreht Rückstand gegen England und fordert Spanien",
      "source": "kicker WM News",
      "url": "https://www.kicker.de/messi-mit-zwei-vorlagen-argentinien-dreht-rueckstand-gegen-england-und-fordert-spanien-1236441/artikel#omrss",
      "publishedAt": "2026-07-15T21:03:24.000Z",
      "snippet": "Die \"Hand Gottes\" und Maradonnas Jahrhunderttor: Das Viertelfinale von 1986 zwischen England und Argentinien hat sich längst ins Gedächtnis des Fußballvolks eingebrannt. Und auch dieses WM-Halbfinale 2026 dürfte in Erinnerung bleiben - aufgrund von vielen Fouls, einer englischen…",
      "impactTag": "none"
    },
    {
      "title": "Argentinien schockt England spät: Titelverteidiger überwindet Tuchel-Elf und steht im WM-Finale",
      "source": "n-tv.de - Fußball",
      "url": "https://www.n-tv.de/sport/fussball-wm/Titelverteidiger-ueberwindet-Tuchel-Elf-und-steht-im-WM-Finale-id31090428.html",
      "publishedAt": "2026-07-15T21:02:51.000Z",
      "snippet": "England und Argentinien liefern sich einen harten Kampf im WM-Halbfinale. Die Three Lions treffen kurz nach der Pause zur Führung, doch das Messi-Team startet einen nicht zu bändigenden Sturmlauf. In der Nachspielzeit fällt der 2:1-Siegtreffer für den Titelverteidiger.",
      "impactTag": "none"
    },
    {
      "title": "Fußball-WM 2026 im Liveticker: Argentinien gewinnt gegen England",
      "source": "DER SPIEGEL - Sport",
      "url": "https://www.spiegel.de/sport/fussball/fussball-wm-2026-im-liveticker-argentinien-gewinnt-gegen-england-a-5156fdee-a670-4ee5-ab8a-927382963207#ref=rss",
      "publishedAt": "2026-07-15T21:02:00.000Z",
      "snippet": "Mit zwei späten Toren hat Argentinien England geschlagen und steht im Endspiel der WM gegen Spanien. England muss weiter auf den ersten Erfolg seit 1966 warten. Alles zum Spiel im Livekommentar.",
      "impactTag": "none"
    },
