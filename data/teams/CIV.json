  "news": [
    {
      "title": "DFB-News: Elfenbeinküste wirft Deutschland \"Mangel an Fairplay\" vor",
      "source": "Fußball-WM 2026: News, Videos und Spielplan zur WM 2026",
      "url": "https://www.sportschau.de/fussball/fifa-wm-2026/curacao-macht-deutschland-zum-gruppensieger,wm-liveblog-dfb-team-100.html",
      "publishedAt": "2026-06-21T11:37:52.000Z",
      "snippet": "Der Trainer der Elfenbeinküste wirft dem DFB-Team nach der Niederlage fehlendes Fairplay vor. WM-Orakel Noah liegt erneut richtig. Alle Nachrichten rund um das DFB-Team im Liveblog.",
      "impactTag": "coach"
    },
    {
      "title": "Ivorischer Coach Faé wirft DFB-Elf mangelndes Fairplay vor",
      "source": "kicker WM News",
      "url": "https://www.kicker.de/ivorischer-coach-fae-wirft-dfb-elf-mangelndes-fairplay-vor-1229970/artikel#omrss",
      "publishedAt": "2026-06-21T11:10:00.000Z",
      "snippet": "Der ivorische Nationalcoach Emerse Faé ärgerte sich nach Abpfiff nicht nur über die späte Niederlage der Elfenbeinküste gegen Deutschland - sondern auch über das aus seiner Sicht unsportliche Verhalten einiger DFB-Akteure.",
      "impactTag": "coach"
    },
    {
      "title": "Szene von Nathaniel Brown: Trainer der Elfenbeinküste wirft DFB-Team mangelndes Fairplay vor",
      "source": "n-tv.de - Fußball",
      "url": "https://www.n-tv.de/sport/fussball-wm/Trainer-der-Elfenbeinkueste-wirft-DFB-Team-mangelndes-Fairplay-vor-id30993321.html",
      "publishedAt": "2026-06-21T10:44:28.000Z",
      "snippet": "Nach der 1:2-Niederlage gegen die deutsche Fußball-Nationalmannschaft ist der ivorische Trainer Emerse Faé mit dem Verhalten des DFB-Teams unzufrieden. Es geht dabei vor allem um eine Szene mit Verteidiger Nathaniel Brown.",
      "impactTag": "coach"
    }
  ]
