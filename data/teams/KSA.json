    {
      "title": "Yamal und Oyarzabal liefern: Gereizte spanische Furie verschlingt Saudi-Arabien",
      "source": "n-tv.de - Fußball",
      "url": "https://www.n-tv.de/sport/fussball-wm/Gereizte-spanische-Furie-verschlingt-Saudi-Arabien-id30994191.html",
