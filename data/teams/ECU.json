    {
      "title": "Fußball-WM 2026: Deutschland unterliegt Ecuador – folgt jetzt eine Debatte über Manuel Neuer?",
      "source": "DER SPIEGEL - Sport",
      "url": "https://www.spiegel.de/sport/fussball/fussball-wm-2026-deutschland-unterliegt-ecuador-folgt-jetzt-eine-debatte-ueber-manuel-neuer-a-fc10b24e-db9e-4402-a15b-7e8f612d7e0e#ref=rss",
      "publishedAt": "2026-06-26T04:40:00.000Z",
      "snippet": "Mit 40 wollte Manuel Neuer noch eine letzte WM-Pointe seiner großen Karriere versuchen. Aber nach dem 1:2 gegen Ecuador steht der Torwart in der Kritik. Klarer Fehler, zu alt? Neuers Antwort: »Nee!«. Aber ist es so einfach?",
      "impactTag": "morale"
    },
    {
      "title": "Ecuadorwand! DFB-Team verliert letztes Gruppenspiel",
      "source": "Fußball-WM 2026: News, Videos und Spielplan zur WM 2026",
      "url": "https://www.sportschau.de/podcasts/sportschau-fussball-podcast/ecuadorwand-dfb-team-verliert-letztes-gruppenspiel,audio-ecuadorwand-dfb-team-verliert-letztes-gruppenspiel-100.html",
      "publishedAt": "2026-06-26T04:35:06.000Z",
      "snippet": "Die Entscheidungen in drei weiteren Gruppen sind gefallen: Deutschland verliert zum Vorrundenabschluss mit 1:2 gegen kämpferische Ecuadorianer und zeigt dabei seine bislang schwächste Turnierleistung. Damit zieht Ecuador als einer der besten Gruppendritten ebenfalls ins Sechzehn…",
      "impactTag": "none"
    },
