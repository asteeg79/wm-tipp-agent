    {
      "title": "\"Lausige 'Les Bleus'\" - Pressestimmen zu Frankreichs WM-Aus und Spaniens Sieg",
      "source": "Fußball-WM 2026: News, Videos und Spielplan zur WM 2026",
      "url": "https://www.sportschau.de/fussball/fifa-wm-2026/pressestimmen-wm-frankreich-spanien-halbfinale,wm-pressestimmen-frankreich-spanien-100.html",
      "publishedAt": "2026-07-14T23:05:10.000Z",
      "snippet": "Spanien erteilt Frankreich im ersten WM-Halbfinale der WM 2026 eine Lehrstunde und zieht verdient ins Finale ein. \"Les Bleus\" hingegen versinken im Tal der Tränen - und kommen in der Presse sehr schlecht weg.",
      "impactTag": "none"
    },
    {
      "title": "WM 2026: Spanien schlägt Frankreich und steht im WM-Finale",
      "source": "Fußball-WM 2026: News, Videos und Spielplan zur WM 2026",
      "url": "https://www.sportschau.de/fussball/fifa-wm-2026/spanien-baendigt-frankreich-und-steht-im-wm-finale,wm-spielbericht-frankreich-spanien-100.html",
      "publishedAt": "2026-07-14T23:00:06.000Z",
      "snippet": "Spanien dominiert das erste Halbfinale der WM 2026 gegen Frankreich und zieht verdient ins Endspiel ein. \"Les Bleus\" bleiben hinter den Erwartungen zurück.",
      "impactTag": "none"
    },
    {
      "title": "De la Fuente: \"Sie haben heute gegen die beste Mannschaft der Welt gespielt\"",
      "source": "kicker WM News",
      "url": "https://www.kicker.de/de-la-fuente-sie-haben-heute-gegen-die-beste-mannschaft-der-welt-gespielt-1236269/artikel#omrss",
      "publishedAt": "2026-07-14T22:44:41.000Z",
      "snippet": "Mit einem hochverdienten 2:0 gegen Frankreich ist Spanien zum zweiten Mal in seiner Geschichte ins WM-Finale eingezogen. Luis de la Fuente sparte nach dem Abpfiff nicht mit Lob für seine Mannschaft.",
      "impactTag": "none"
    },
    {
      "title": "Spanien steht im WM-Finale",
      "source": "kicker WM News",
      "url": "https://www.kicker.de/spanien-steht-im-wm-finale-1236285/artikel#omrss",
      "publishedAt": "2026-07-14T22:40:00.000Z",
      "snippet": "Die Weltmeisterschaft biegt auf die Zielgerade ein - angefangen mit dem ersten Halbfinale. Hier konnten Frankreichs Stars keinen Sieg erringen und schieden gegen ein starkes Spanien verdient mit 0:2 aus.",
      "impactTag": "none"
    },
